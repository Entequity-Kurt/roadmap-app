# Local Postgres. Copy this file to .env (gitignored) and adjust if needed.
# Homebrew postgresql@17 listens on port 5432. The OS user is used when the
# URL has no username, which matches a default Homebrew install.
DATABASE_URL=postgresql://localhost:5432/ds_kanban

# next start reads PORT. 3000 is the default when this is unset.
PORT=3000
